diff --git a/app/src/main/java/helium314/keyboard/latin/inputlogic/SgaMapper.kt b/app/src/main/java/helium314/keyboard/latin/inputlogic/SgaMapper.kt
new file mode 100644
index 0000000..2d27dda
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/latin/inputlogic/SgaMapper.kt
@@ -0,0 +1,15 @@
+package helium314.keyboard.latin.inputlogic
+
+object SgaMapper {
+    private val map = mapOf(
+        'a' to "ᔑ", 'b' to "ʖ", 'c' to "ᓵ", 'd' to "↸", 'e' to "ᒷ", 'f' to "⎓", 'g' to "⊣",
+        'h' to "⍑", 'i' to "╎", 'j' to "⋮", 'k' to "ꖌ", 'l' to "ꖎ", 'm' to "ᒲ", 'n' to "リ",
+        'o' to "𝙹", 'p' to "!¡", 'q' to "ᑑ", 'r' to "∷", 's' to "ᓭ", 't' to "ㄒ\u0323",
+        'u' to "⚍", 'v' to "⍊", 'w' to "∴", 'x' to "\u02D9/", 'y' to "‖", 'z' to "⨅",
+    )
+
+    /** SGA string for a Latin letter code point, or null for anything else */
+    @JvmStatic
+    fun map(codePoint: Int): String? =
+        if (codePoint in 'A'.code..'z'.code) map[codePoint.toChar().lowercaseChar()] else null
+}
