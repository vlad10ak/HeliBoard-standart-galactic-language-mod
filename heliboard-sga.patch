--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/latin/inputlogic/SgaMapper.kt
@@ -0,0 +1,41 @@
+package helium314.keyboard.latin.inputlogic
+
+import helium314.keyboard.latin.RichInputMethodManager
+
+/** Standard Galactic Alphabet (Minecraft enchanting table): Latin letters in, galactic glyphs out. */
+object SgaMapper {
+    const val LAYOUT_NAME = "sga"
+
+    private val map = mapOf(
+        'a' to "ᔑ", 'b' to "ʖ", 'c' to "ᓵ", 'd' to "↸", 'e' to "ᒷ", 'f' to "⎓", 'g' to "⊣",
+        'h' to "⍑", 'i' to "╎", 'j' to "⋮", 'k' to "ꖌ", 'l' to "ꖎ", 'm' to "ᒲ", 'n' to "リ",
+        'o' to "𝙹", 'p' to "!¡", 'q' to "ᑑ", 'r' to "∷", 's' to "ᓭ", 't' to "ㄒ\u0323",
+        'u' to "⚍", 'v' to "⍊", 'w' to "∴", 'x' to "\u02D9/", 'y' to "‖", 'z' to "⨅",
+    )
+
+    /** galactic string for a Latin letter code point, or null for anything else */
+    @JvmStatic
+    fun map(codePoint: Int): String? =
+        if (codePoint in 'A'.code..'z'.code) map[codePoint.toChar().lowercaseChar()] else null
+
+    /** replaces all Latin letters in [text], returns [text] itself if there are none */
+    @JvmStatic
+    fun mapText(text: CharSequence): CharSequence {
+        val sb = StringBuilder()
+        var changed = false
+        for (c in text) {
+            val m = map(c.code)
+            if (m != null) { sb.append(m); changed = true } else sb.append(c)
+        }
+        return if (changed) sb else text
+    }
+
+    @JvmStatic
+    fun isSga(layoutName: String?) = layoutName == LAYOUT_NAME
+
+    /** whether the currently selected subtype uses the galactic layout */
+    @JvmStatic
+    fun isActive(): Boolean = try {
+        isSga(RichInputMethodManager.getInstance().currentSubtype.mainLayoutName)
+    } catch (e: Exception) { false }
+}
